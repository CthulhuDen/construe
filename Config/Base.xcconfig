// Shared build settings for all targets.
//
// Per-developer settings (DEVELOPMENT_TEAM, PRODUCT_BUNDLE_IDENTIFIER) go in
// Local.xcconfig, which is git-ignored. Copy Local.xcconfig.example to get started.

DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.example.construe

// Anthropic API key for the Integration test plan only; the app itself uses the Keychain.
ANTHROPIC_API_KEY =

#include "Version.xcconfig"

#include? "Local.xcconfig"
