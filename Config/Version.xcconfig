// App version, shared by all targets. Bump both for every release:
// MARKETING_VERSION is the user-facing version (CFBundleShortVersionString) and matches the
// release tag without its "v"; CURRENT_PROJECT_VERSION is the build number (CFBundleVersion),
// which must increase with every release.

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
